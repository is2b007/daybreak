<%#
  "COMPLETE" sits on a straight banner, not a textPath arc. The arc version
  smeared the letters into an unreadable ring at card size.
%>
<svg class="stamp stamp--brown-complete" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <g transform="rotate(-3 50 50)">
    <circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="4.4" stroke-linecap="round"
            stroke-dasharray="37 3 49 2 44 4 35 2 53 3 46 2" opacity="0.94"/>
    <circle cx="50" cy="50" r="37" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"
            stroke-dasharray="60 3 47 2 58 4" opacity="0.45"/>

    <path d="M13.5 40 H86.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
          stroke-dasharray="30 3 38 2" opacity="0.72"/>
    <path d="M13.5 61 H86.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
          stroke-dasharray="34 3 33 2" opacity="0.72"/>

    <%# dx offsets the trailing letter-space so the word optically centres in the banner. %>
    <text x="50" y="55.5" dx="0.7" text-anchor="middle"
          font-family="Georgia, 'Times New Roman', serif" font-size="11.5" font-weight="700"
          letter-spacing="1.4" fill="currentColor" opacity="0.96">COMPLETE</text>

    <path d="M38 27.5 L45 34 L62 20.5" stroke="currentColor" stroke-width="3.4"
          stroke-linecap="round" stroke-linejoin="round" opacity="0.8"/>
  </g>

  <g fill="currentColor" opacity="0.45">
    <circle cx="22" cy="30" r="0.85"/>
    <circle cx="80" cy="70" r="0.75"/>
    <circle cx="18" cy="68" r="0.65"/>
    <circle cx="74" cy="25" r="0.6"/>
    <circle cx="50" cy="86" r="0.6"/>
  </g>
</svg>
