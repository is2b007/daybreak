<%#
  Ink texture is drawn, not filtered. The old feTurbulence/feDisplacementMap ran
  once per completed card and only fuzzed the edges; broken dash patterns plus
  hand-placed speckles read as worn rubber and cost nothing to paint.
%>
<svg class="stamp stamp--red-done" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <g transform="rotate(-4 50 50)">
    <circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="5" stroke-linecap="round"
            stroke-dasharray="34 3 52 2 41 4 28 2 47 3 55 2" opacity="0.95"/>
    <circle cx="50" cy="50" r="36.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
            stroke-dasharray="48 3 61 2 39 4 70" opacity="0.5"/>

    <text x="50" y="57" text-anchor="middle"
          font-family="Georgia, 'Times New Roman', serif" font-size="20" font-weight="700"
          letter-spacing="2.4" fill="currentColor" opacity="0.96">DONE</text>

    <path d="M23 39 H77" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
          stroke-dasharray="21 3 28 2" opacity="0.62"/>
    <path d="M25 64 H75" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
          stroke-dasharray="19 3 26 2" opacity="0.62"/>
  </g>

  <g fill="currentColor" opacity="0.45">
    <circle cx="21" cy="31" r="0.9"/>
    <circle cx="79" cy="66" r="0.8"/>
    <circle cx="30" cy="77" r="0.7"/>
    <circle cx="72" cy="23" r="0.75"/>
    <circle cx="14" cy="55" r="0.6"/>
    <circle cx="87" cy="45" r="0.55"/>
  </g>
</svg>
