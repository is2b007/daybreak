<% content_for(:topbar) do %>
  <div class="week-nav">
    <div class="week-nav__arrows">
      <%= link_to week_path(@window_start - 7.days), class: "topbar__nav-arrow", title: "Previous week", aria: { label: "Previous week" } do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      <% end %>
    </div>
    <span class="topbar__title"><%= @window_start.strftime("%b %-d") %> &ndash; <%= @display_end.strftime("%b %-d") %></span>
    <div class="week-nav__arrows">
      <%= link_to week_path(@window_start + 7.days), class: "topbar__nav-arrow", title: "Next week", aria: { label: "Next week" } do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      <% end %>
    </div>
    <span class="topbar__sub"><%= @window_start.strftime("%Y") %></span>
    <% unless @window_dates.include?(Date.current) %>
      <%= link_to "This week", root_path, class: "btn btn--pill btn--small week-nav__today" %>
    <% end %>
  </div>
<% end %>

<div class="week-view" data-controller="sortable week-board">
  <div class="kanban" data-week-board-target="board">
    <% @window_dates.each_with_index do |date, i| %>
      <%= render "day_column", date: date, tasks: @tasks_by_day[date] || [], events: @calendar_events[date] || [], first: i.zero? %>
    <% end %>
  </div>

  <%= render "sometime_row", tasks: @sometime_tasks %>
</div>
