<%= render layout: "step", locals: { step: 4, elevation: 0.66 } do %>
  <%= image_tag "tiles/basecamp.png", class: "onb__app-icon", alt: "", data: { reveal: "" } %>
  <h1 class="onb__title" id="onb-title-4" tabindex="-1" data-reveal="words">Your Basecamp work.</h1>
  <p class="onb__prose" data-reveal>Daybreak is already connected to Basecamp. Continue, and your assigned to-dos start coming in.</p>

  <ul class="onb__list">
    <li data-reveal>Assigned to-dos land in your inbox, ready to plan</li>
    <li data-reveal>Schedule events sit alongside your day</li>
    <li data-reveal>Finish something here and it&rsquo;s done in Basecamp too</li>
  </ul>

  <%= form_with url: onboarding_path, method: :patch, class: "onb__actions", data: { reveal: "" } do |f| %>
    <%= f.hidden_field :step, value: 4 %>
    <%= link_to "Back", onboarding_path(step: 3), class: "onb__button onb__button--quiet" %>
    <button type="submit" class="onb__button onb__button--primary">Bring it in</button>
  <% end %>
<% end %>
