<%= render layout: "step", locals: { step: 3, elevation: 0.6 } do %>
  <h1 class="onb__title" id="onb-title-3" tabindex="-1" data-reveal="words">Nice to meet you, <%= current_user.greeting_name %>.</h1>
  <p class="onb__prose" data-reveal>Pick a stamp. Daybreak stamps your to-dos with it when they&rsquo;re done. You can change it later in Settings.</p>

  <%= form_with url: onboarding_path, method: :patch, class: "onb__form", data: { controller: "stamp-picker" } do |f| %>
    <%= f.hidden_field :step, value: 3 %>
    <%= f.hidden_field :stamp_choice, value: current_user.stamp_choice, data: { stamp_picker_target: "input" } %>

    <div class="onb__stamps" role="group" aria-label="Stamps" data-reveal>
      <% User::STAMP_OPTIONS.each do |stamp| %>
        <button type="button"
                class="stamp-option onb__stamp <%= 'stamp-option--selected' if current_user.stamp_choice == stamp %>"
                data-action="click->stamp-picker#select click->onboarding#stamp"
                data-stamp="<%= stamp %>"
                aria-label="<%= stamp.humanize %> stamp"
                aria-pressed="<%= current_user.stamp_choice == stamp %>">
          <%= render "stamps/#{stamp}" %>
        </button>
      <% end %>
    </div>

    <div class="onb__card" aria-hidden="true" data-reveal data-onboarding-target="card">
      <span class="onb__card-title">Water the plants</span>
      <span class="onb__card-mark">
        <span class="onb__card-stamp" data-stamp-picker-target="stampPreview"><%= render "stamps/#{current_user.stamp_choice}" %></span>
        <%# The rubber stamp itself: drops in, presses, lifts away (onboarding#stamp) %>
        <svg class="onb__stamper" data-onboarding-target="stamper" viewBox="0 0 64 96">
          <ellipse cx="32" cy="14" rx="15" ry="12" class="onb__stamper-wood"/>
          <ellipse cx="27" cy="10" rx="5" ry="3.5" fill="#fff" opacity="0.28"/>
          <path d="M26 24h12l3 30H23z" class="onb__stamper-wood"/>
          <rect x="8" y="52" width="48" height="22" rx="4" class="onb__stamper-block"/>
          <rect x="8" y="52" width="48" height="5" rx="2.5" fill="#fff" opacity="0.18"/>
          <rect x="11" y="74" width="42" height="8" rx="2" class="onb__stamper-rubber"/>
        </svg>
      </span>
    </div>

    <div class="onb__actions" data-reveal>
      <button type="submit" class="onb__button onb__button--primary">Continue</button>
    </div>
  <% end %>
<% end %>
