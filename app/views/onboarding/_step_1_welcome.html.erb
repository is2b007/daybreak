<%= render layout: "step", locals: { step: 1, elevation: 0.02 } do %>
  <%= image_tag "daybreak-logo.svg", class: "onb__logo", alt: "", data: { reveal: "" } %>
  <h1 class="onb__title" id="onb-title-1" tabindex="-1" data-reveal="words">Welcome to Daybreak.</h1>
  <p class="onb__prose" data-reveal>
    A calm place to plan your week, with your Basecamp and HEY work close at hand.
    Let&rsquo;s set it up together. It takes about a minute.
  </p>

  <%= form_with url: onboarding_path, method: :patch, class: "onb__actions", data: { reveal: "" } do |f| %>
    <%= f.hidden_field :step, value: 1 %>
    <button type="submit" class="onb__button onb__button--primary">Begin</button>
  <% end %>
  <p class="onb__hint" data-reveal>Best with sound on.</p>
<% end %>
