<%# locals: (task:, bc_comments: [], bc_comments_error: nil, card_columns: nil, card_steps: []) %>
<% hey_from_email = task.hey_app_url.present? %>
<div class="modal-overlay"
     data-controller="modal"
     data-action="click->modal#closeIfBackdrop">
  <div class="modal modal--task">

    <%# Top bar: project/channel + close %>
    <% bc_web_url = task.basecamp_web_url %>
    <div class="modal__topbar">
      <div class="modal__channel">
        <% if task.basecamp? %>
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" class="modal__channel-icon">
            <circle cx="5" cy="5" r="4.5" stroke="currentColor" stroke-width="1"/>
          </svg>
          <span><%= task.project_name.presence || "Basecamp" %></span>
        <% elsif task.hey? || task.hey_app_url.present? %>
          <span>HEY Email</span>
        <% else %>
          <span>Local task</span>
        <% end %>
      </div>
      <div class="modal__topbar-actions">
        <%# Add to Today — show when the task isn't already on today's plan %>
        <% unless task.day_plan&.date == Date.current %>
          <%= button_to "Add to Today",
                move_task_assignment_path(task),
                method: :patch,
                params: { target_date: Date.current.iso8601, position: 0 },
                class: "btn btn--secondary btn--small modal__add-today-btn",
                form: { data: { turbo_stream: true } } %>
        <% end %>
        <%# Focus button %>
        <button type="button"
                class="modal__focus-btn btn btn--ghost btn--small"
                data-task-id="<%= task.id %>"
                onclick="document.querySelector('[data-action*=\'modal#close\']')?.dispatchEvent(new Event('click')); setTimeout(() => Turbo.visit('/task_assignments/<%= task.id %>/focus', { frame: 'focus' }), 50)"
                title="Focus on this task (F)">
          Focus
        </button>
        <details class="modal__menu">
          <summary class="modal__menu-btn" aria-label="Task options">•••</summary>
          <div class="modal__menu-pop">
            <%= button_to "Delete",
                  task_assignment_path(task),
                  method: :delete,
                  form: { data: { turbo_confirm: "Delete this task?" } },
                  class: "modal__menu-item modal__menu-item--danger" %>
          </div>
        </details>
        <% if task.safe_hey_app_url.present? %>
          <%= link_to task.safe_hey_app_url,
                target: "_blank",
                rel: "noopener noreferrer",
                class: "modal__ext-link",
                title: "Open in HEY",
                aria: { label: "Open email in HEY" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          <% end %>
        <% end %>
        <% if bc_web_url.present? %>
          <%= link_to bc_web_url,
                target: "_blank",
                rel: "noopener noreferrer",
                class: "modal__ext-link",
                title: "Open in Basecamp",
                aria: { label: "Open task in Basecamp" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          <% end %>
        <% end %>
        <button type="button"
                class="modal__close"
                data-action="click->modal#close"
                aria-label="Close modal">×</button>
      </div>
    </div>

    <%# Main form — auto-saves on blur/change, no submit button %>
    <%= form_with model: task,
          data: { controller: "auto-save", turbo: true, turbo_stream: true } do |f| %>

      <%# Title row with squarish checkbox icon %>
      <div class="modal__title-row">
        <% if task.basecamp_card? %>
          <div class="modal__check-icon modal__check-icon--card" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect x="2" y="3" width="4.5" height="14" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <rect x="8.5" y="3" width="4.5" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <rect x="15" y="3" width="3" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
        <% else %>
          <div class="modal__check-icon <%= 'modal__check-icon--done' if task.completed? %>" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <% if task.completed? %>
                <circle cx="10" cy="10" r="9" fill="#16A34A"/>
                <polyline points="6,10.5 8.8,13.2 14,7.5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              <% else %>
                <circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.5"/>
              <% end %>
            </svg>
          </div>
        <% end %>
        <%= f.text_area :title,
              class: "modal__title-input #{'modal__title-input--done' if task.completed?}",
              required: true,
              placeholder: "Task title",
              rows: 1,
              readonly: hey_from_email,
              data: hey_from_email ? {} : { action: "blur->auto-save#save input->auto-save#resizeTitle" } %>
      </div>

      <%# Body %>
      <div class="modal__body">
        <% if hey_from_email && @hey_email_body.present? %>
          <div class="modal__section">
            <div class="modal__section-label">HEY body</div>
            <textarea class="form-input modal__description" rows="4" readonly><%= @hey_email_body %></textarea>
          </div>
        <% end %>
        <% if task.basecamp_card? %>
          <div class="modal__section">
            <div class="modal__section-label" id="stage-label-<%= task.id %>">Stage</div>
            <% if card_columns.present? %>
              <div class="stage-picker" role="group" aria-labelledby="stage-label-<%= task.id %>">
                <%# Buttons point at forms rendered after the edit form: forms can't nest %>
                <% card_columns[:columns].each do |column| %>
                  <% current = column["id"].to_s == card_columns[:current_id].to_s %>
                  <% done = column["type"] == BasecampClient::DONE_COLUMN_TYPE %>
                  <button type="submit" form="stage-<%= task.id %>-<%= column["id"] %>"
                          class="stage-picker__step <%= 'stage-picker__step--current' if current %> <%= 'stage-picker__step--done' if done %>"
                          <%= "disabled aria-current=step" if current %>>
                    <% if done %><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6.3l2.2 2.2 4.8-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><% end %>
                    <%= column["title"] %>
                  </button>
                <% end %>
              </div>
            <% else %>
              <p class="stage-picker__fallback">
                <span class="stage-picker__step stage-picker__step--current"><%= task.basecamp_column_name.presence || "Unknown stage" %></span>
                <span class="text-muted">Couldn’t load this card’s columns from Basecamp.</span>
              </p>
            <% end %>
          </div>
        <% end %>

        <% if card_steps.present? %>
          <div class="modal__section">
            <div class="modal__section-label">Steps · <%= card_steps.count { |st| st["completed"] } %> of <%= card_steps.size %> done</div>
            <ul class="card-steps">
              <% card_steps.each do |step| %>
                <li class="card-steps__item <%= 'card-steps__item--done' if step["completed"] %>">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <% if step["completed"] %>
                      <circle cx="8" cy="8" r="7" fill="#16A34A"/><path d="M5 8.2l2 2 4-4.4" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <% else %>
                      <circle cx="8" cy="8" r="6.6" stroke="currentColor" stroke-width="1.25"/>
                    <% end %>
                  </svg>
                  <span class="card-steps__title"><%= step["title"].presence || step["content"] %></span>
                  <% if step["due_on"].present? %>
                    <span class="card-steps__due"><%= Date.parse(step["due_on"]).strftime("%b %-d") rescue step["due_on"] %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if task.basecamp? %>
          <% if task.description.present? %>
            <div class="modal__section">
              <div class="modal__section-label">Description</div>
              <div class="modal__richtext rich-text"><%= basecamp_rich_text(task.description) %></div>
            </div>
          <% end %>
          <div class="modal__section">
            <div class="modal__section-label">Your notes</div>
            <%= f.text_area :notes,
                  class: "form-input modal__description",
                  rows: 3,
                  placeholder: "Private to you, not synced to Basecamp",
                  data: { action: "blur->auto-save#save" } %>
          </div>
        <% else %>
          <div class="modal__section">
            <div class="modal__section-label">Description</div>
            <%= f.text_area :description,
                  class: "form-input modal__description",
                  rows: 3,
                  placeholder: hey_from_email ? "Your notes (saved here only, not synced to HEY)" : "Add a description…",
                  data: { action: "blur->auto-save#save" } %>
          </div>
        <% end %>

      </div>
    <% end %>

    <% if task.basecamp_card? && card_columns.present? %>
      <% card_columns[:columns].each do |column| %>
        <%= form_with url: stage_task_assignment_path(task), method: :patch, id: "stage-#{task.id}-#{column["id"]}",
              class: "stage-picker__form", data: { turbo_stream: true } do |sf| %>
          <%= hidden_field_tag :column_id, column["id"], id: nil %>
          <%= hidden_field_tag :column_title, column["title"], id: nil %>
          <%= hidden_field_tag :column_type, column["type"], id: nil %>
        <% end %>
      <% end %>
    <% end %>

    <%# Comments section — Basecamp tasks only %>
    <% if task.basecamp? %>
      <div class="modal__comments-section">
        <% if bc_comments_error.present? %>
          <div class="modal__comments-error" role="status">
            <span><%= bc_comments_error %></span>
            <%= link_to "Retry", task_assignment_path(task), data: { turbo_frame: "modal" }, class: "modal__comments-error-retry" %>
          </div>
        <% elsif bc_comments.any? %>
          <div class="modal__comments-list">
            <% bc_comments.each do |c| %>
              <% author = c.dig("creator", "name").to_s %>
              <% avatar = c.dig("creator", "avatar_url").to_s %>
              <div class="bc-comment">
                <% if avatar.match?(%r{\Ahttps://[^/]+/.*people/.+/avatar}) %>
                  <%= image_tag basecamp_person_avatar_path(u: avatar), alt: "", class: "bc-comment__avatar", loading: "lazy" %>
                <% else %>
                  <%= contact_avatar(author) %>
                <% end %>
                <div class="bc-comment__main">
                  <div class="bc-comment__meta">
                    <span class="bc-comment__author"><%= author %></span>
                    <% if c["created_at"].present? %>
                      <time class="bc-comment__time" datetime="<%= c["created_at"] %>"><%= time_ago_in_words(Time.parse(c["created_at"])) %> ago</time>
                    <% end %>
                  </div>
                  <div class="bc-comment__content rich-text"><%= basecamp_rich_text(c["content"]) %></div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= render "task_assignments/comment_form", task: task %>
      </div>
    <% end %>

  </div>
</div>
