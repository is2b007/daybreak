<%# locals: (task:) %>
<% pn = task.project_name.to_s.strip %>
<div
  class="r-item"
  id="inbox_task_<%= task.id %>"
  draggable="true"
  data-bc-inbox-panel-target="item"
  data-task-id="<%= task.id %>"
  data-project-name="<%= h(pn) %>"
  data-planned-start="<%= task.planned_start_at&.iso8601 %>"
  data-created-at="<%= task.created_at&.iso8601 %>"
  data-title="<%= h(task.title) %>"
  data-action="click->bc-inbox-panel#openModal dragstart->bc-inbox-panel#dragstart dragend->bc-inbox-panel#dragend">
  <div class="r-item__check">
    <% if task.basecamp_card? %>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <rect x="1.5" y="2.5" width="3.5" height="11" rx="1.2" stroke="currentColor" stroke-width="1.25"/>
        <rect x="6.5" y="2.5" width="3.5" height="7" rx="1.2" stroke="currentColor" stroke-width="1.25"/>
        <rect x="11.5" y="2.5" width="3" height="9" rx="1.2" stroke="currentColor" stroke-width="1.25"/>
      </svg>
    <% else %>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6.6" stroke="currentColor" stroke-width="1.25"/>
      </svg>
    <% end %>
  </div>
  <div class="r-item-body">
    <div class="r-item-name"><%= task.title %></div>
    <% if pn.present? || task.basecamp_column_name.present? %>
      <div class="r-item-project">
        <%= pn %>
        <% if task.basecamp_card? && task.basecamp_column_name.present? %>
          <span class="r-item-stage"><%= task.basecamp_column_name %></span>
        <% end %>
      </div>
    <% elsif task.hey? %>
      <div class="r-item-project">HEY Email</div>
    <% end %>
    <div class="r-item-drag-hint">
      <svg width="12" height="10" viewBox="0 0 12 10" fill="currentColor" aria-hidden="true">
        <rect y="0" width="12" height="1.5" rx="0.75"/>
        <rect y="4" width="12" height="1.5" rx="0.75"/>
        <rect y="8" width="12" height="1.5" rx="0.75"/>
      </svg>
    </div>
  </div>
</div>
