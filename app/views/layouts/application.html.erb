<!DOCTYPE html>
<html lang="en"<%= %( data-theme="#{theme_attribute}").html_safe if theme_attribute %>>
  <head>
    <title><%= content_for(:title) || "Daybreak" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="Daybreak">
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0E1A1F" media="(prefers-color-scheme: dark)">
    <meta name="color-scheme" content="<%= theme_attribute == "paper" ? "light" : (theme_attribute || "light dark") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-maskable.png">
    <%= tag.link rel: "manifest", href: pwa_manifest_path %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="hotkeys"
        data-hotkeys-week-value="<%= root_path %>"
        data-hotkeys-today-value="<%= day_path(Date.current) %>"
        data-hotkeys-sunrise-value="<%= ritual_morning_path %>"
        data-hotkeys-sundown-value="<%= ritual_evening_path %>"
        data-hotkeys-daily-log-value="<%= day_path(Date.current, tab: 'log') %>"
        data-hotkeys-checkin-value="<%= weekly_checkin_path %>">
    <% if logged_in? && current_user.onboarded? && !content_for?(:full_screen) %>
      <% if logged_in? %>
        <template data-user-stamp-svg>
          <%= render "stamps/#{current_user.stamp_choice}" %>
        </template>
      <% end %>

      <% hide_inbox_panel = controller_name == "rituals" && %w[evening evening_complete].include?(action_name) %>
      <div class="shell<%= " shell--no-right" if hide_inbox_panel %>">
        <%= render "layouts/sidebar" %>

        <% if follows_the_sun? %>
        <main class="mid" data-controller="sun-theme" data-sun-theme-timezone-value="<%= current_user.timezone %>" data-sun-theme-sundown-value="<%= current_user.sundown_time %>">
        <% else %>
        <main class="mid">
        <% end %>
          <div class="topbar">
            <%= yield(:topbar) %>
          </div>
          <% if @active_timer %>
            <div class="mid__timer">
              <%= render "layouts/active_timer_bar", timer: @active_timer %>
            </div>
          <% end %>
          <div class="view-area">
            <% if flash[:notice] %>
              <div class="flash flash--notice" data-controller="flash"><%= flash[:notice] %></div>
            <% end %>
            <% if flash[:alert] %>
              <div class="flash flash--alert" data-controller="flash"><%= flash[:alert] %></div>
            <% end %>
            <% if current_user&.hey_reconnect_needed_at.present? && !current_user.hey_connected? %>
              <div class="flash flash--alert hey-reconnect">
                <span>HEY stopped accepting Daybreak&rsquo;s connection, so HEY sync is paused.</span>
                <%= link_to "Reconnect HEY", auth_hey_path, class: "btn btn--primary btn--small" %>
                <%= link_to "Turn off HEY", disconnect_hey_path, data: { turbo_method: :delete }, class: "btn btn--ghost btn--small" %>
              </div>
            <% end %>
            <%= yield %>
          </div>
        </main>

        <% unless hide_inbox_panel %>
          <div class="right" data-controller="right-panel">
            <%= render "layouts/right_panel" %>
          </div>
        <% end %>
        <%= render "layouts/mobile_tabbar", hide_inbox_panel: hide_inbox_panel %>
      </div>
    <% else %>
      <% if logged_in? %>
        <template data-user-stamp-svg>
          <%= render "stamps/#{current_user.stamp_choice}" %>
        </template>
      <% end %>

      <main class="app-main">
        <% if flash[:notice] %>
          <div class="flash flash--notice" data-controller="flash"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="flash flash--alert" data-controller="flash"><%= flash[:alert] %></div>
        <% end %>
        <%= yield %>
      </main>
    <% end %>
    <% if flash[:arrival] && logged_in? && current_user.onboarded? %>
      <div class="arrival" aria-hidden="true" data-turbo-temporary></div>
    <% end %>
    <%= turbo_frame_tag "modal" %>
    <%= turbo_frame_tag "focus" %>
  </body>
</html>
