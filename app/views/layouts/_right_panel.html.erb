<button type="button" class="right__resizer" data-action="pointerdown->right-panel#startResize" aria-label="Resize side panel" title="Drag to resize panel"></button>
<div class="r-content" data-right-panel-target="content">
  <% if @right_panel_errors.present? %>
    <div class="r-errors" role="status" aria-live="polite" title="<%= @right_panel_errors.join('. ') %>">
      <span class="r-errors__dot">·</span>
      <span class="r-errors__msg"><%= pluralize(@right_panel_errors.size, 'item') %> didn't load</span>
    </div>
  <% end %>
  <%# Basecamp tab %>
  <div class="r-tab-content on" id="rc-bc" data-right-panel-target="tab" data-tab="bc" data-controller="bc-inbox-panel"<%= %( data-bc-inbox-panel-arriving-value="true").html_safe if flash[:arrival] && @rp_bc_tasks.blank? %>
       data-bc-inbox-panel-next-offset-value="<%= @rp_bc_tasks&.size || 0 %>">
    <div class="r-head">
      <div class="r-dot r-dot--bc"></div>
      <div class="r-head-title">Basecamp</div>
      <div class="r-cnt" data-right-panel-target="bcCount" data-bc-inbox-panel-target="count"><%= @rp_bc_tasks&.count || 0 %></div>
      <div class="r-head-spacer"></div>
      <button type="button"
              class="r-sync-btn"
              title="Sync Basecamp"
              data-controller="sync-btn"
              data-sync-btn-url-value="<%= sync_basecamp_path %>"
              data-sync-btn-panel-value="bc-inbox-panel"
              data-action="click->sync-btn#sync">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="23 4 23 10 17 10"/>
          <polyline points="1 20 1 14 7 14"/>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
        </svg>
      </button>
    </div>
    <div class="r-filter">
      <select class="r-select" data-bc-inbox-panel-target="projectSelect" data-action="change->bc-inbox-panel#apply" aria-label="Filter by project">
        <option value="">All projects</option>
        <% (@rp_bc_project_names || []).each do |name| %>
          <option value="<%= h(name) %>"><%= h(name) %></option>
        <% end %>
        <% if @rp_bc_has_blank_project %>
          <option value="__empty__">(No project)</option>
        <% end %>
      </select>
      <select class="r-sort" data-bc-inbox-panel-target="sortSelect" data-action="change->bc-inbox-panel#apply" aria-label="Sort tasks">
        <option value="due_date">Due date</option>
        <option value="alphabetical">Alphabetical</option>
        <option value="recently_created">Recently created</option>
      </select>
    </div>
    <div class="r-empty r-empty--filtered" hidden data-bc-inbox-panel-target="filteredEmpty">No tasks match this filter.</div>
    <div class="r-list" id="bc-inbox-list" data-bc-inbox-panel-target="list"
         data-action="scroll->bc-inbox-panel#onScroll dragover->bc-inbox-panel#dragover dragleave->bc-inbox-panel#dragleave drop->bc-inbox-panel#drop">
      <% if @rp_bc_tasks&.any? %>
        <%= render "layouts/bc_inbox_items", tasks: @rp_bc_tasks %>
      <% else %>
        <% settled_title = "Nothing assigned to you" %>
        <% settled_sub = "To-dos assigned to you in Basecamp show up here, ready to drag onto a day." %>
        <%# Straight after onboarding the first sync is still running, so say so and watch for it %>
        <div class="r-empty" data-bc-inbox-panel-target="empty"
             data-settled-title="<%= settled_title %>" data-settled-sub="<%= settled_sub %>">
          <%= source_tile "basecamp", class: "r-empty__tile" %>
          <p class="r-empty__title" data-bc-inbox-panel-target="emptyTitle"><%= flash[:arrival] ? "Bringing in your to-dos" : settled_title %></p>
          <p class="r-empty__sub" data-bc-inbox-panel-target="emptySub"><%= flash[:arrival] ? "Your Basecamp assignments land here as they sync, ready to drag onto a day." : settled_sub %></p>
        </div>
      <% end %>
      <div class="r-list__loader" data-bc-inbox-panel-target="loader"><div class="r-list__spinner"></div></div>
    </div>
  </div>

  <%# HEY tab %>
  <div class="r-tab-content" id="rc-hey" data-right-panel-target="tab" data-tab="hey"
       data-controller="hey-inbox-panel"
       data-hey-inbox-panel-next-offset-value="<%= current_user.hey_connected? ? (@rp_hey_emails&.size || 0) : 0 %>">
    <div class="r-head">
      <div class="r-dot r-dot--hey"></div>
      <div class="r-head-title">HEY</div>
      <div class="r-cnt" data-right-panel-target="heyCount" data-hey-inbox-panel-target="count"><%= @rp_hey_emails&.count || 0 %></div>
      <% if current_user.hey_connected? %>
        <div class="r-head-spacer"></div>
        <button type="button"
                class="r-sync-btn"
                title="Sync HEY"
                data-controller="sync-btn"
                data-sync-btn-url-value="<%= sync_hey_path %>"
                data-sync-btn-panel-value="hey-inbox-panel"
                data-action="click->sync-btn#sync">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10"/>
            <polyline points="1 20 1 14 7 14"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
        </button>
      <% end %>
    </div>
    <% if current_user.hey_connected? %>
      <div class="r-filter">
        <% if @rp_hey_mailboxes&.many? %>
          <select class="r-select" data-hey-inbox-panel-target="accountSelect" data-action="change->hey-inbox-panel#onAccountChange" aria-label="Switch mailbox">
            <option value="">All mailboxes</option>
            <% @rp_hey_mailboxes.each do |mailbox| %>
              <option value="<%= mailbox["id"] %>"><%= mailbox["name"].presence || mailbox["domain"].presence || "Mailbox" %></option>
            <% end %>
          </select>
        <% end %>
        <select class="r-select" data-hey-inbox-panel-target="folderSelect" data-action="change->hey-inbox-panel#onFolderChange" aria-label="Switch box">
          <option value="imbox">Imbox</option>
          <option value="reply_later">Reply later</option>
          <option value="set_aside">Set aside</option>
          <option value="feed">Feed</option>
          <option value="paper_trail">Paper Trail</option>
        </select>
        <% if @rp_hey_labels&.any? %>
          <select class="r-sort" data-hey-inbox-panel-target="labelSelect" data-action="change->hey-inbox-panel#onLabelChange" aria-label="Filter by label">
            <option value="">All labels</option>
            <% @rp_hey_labels.each do |lbl| %>
              <option value="<%= h(lbl) %>"><%= h(lbl) %></option>
            <% end %>
          </select>
        <% end %>
      </div>
      <div class="r-empty r-empty--filtered" hidden data-hey-inbox-panel-target="filteredEmpty">No emails match this label.</div>
      <div class="r-list" id="hey-inbox-list" data-hey-inbox-panel-target="list"
           data-action="scroll->hey-inbox-panel#onScroll dragover->hey-inbox-panel#dragover dragleave->hey-inbox-panel#dragleave drop->hey-inbox-panel#drop">
        <% if @rp_hey_emails&.any? %>
          <%= render "layouts/hey_inbox_items", emails: @rp_hey_emails %>
        <% end %>
        <div data-hey-inbox-panel-target="sentinel" class="hey-inbox__sentinel" aria-hidden="true"></div>
        <div class="r-list__loader" data-hey-inbox-panel-target="loader"><div class="r-list__spinner"></div></div>
        <div class="r-empty" data-hey-inbox-panel-target="empty" <%= @rp_hey_emails&.any? ? 'hidden' : '' %>>
          <%= source_tile "hey", class: "r-empty__tile" %>
          <p class="r-empty__title">All clear</p>
          <p class="r-empty__sub">No emails in this mailbox.</p>
        </div>
      </div>
    <% else %>
      <div class="r-empty">
        <%= source_tile "hey", class: "r-empty__tile" %>
        <p class="r-empty__title">Bring in your HEY inbox</p>
        <p class="r-empty__sub">Turn emails into tasks by dragging them onto a day.</p>
        <%= link_to "Connect HEY", auth_hey_path, class: "btn btn--primary btn--small" %>
      </div>
    <% end %>
  </div>

  <%# Daily log tab %>
  <div class="r-tab-content" id="rc-log" data-right-panel-target="tab" data-tab="log"
       data-controller="journal-editor"
       data-journal-editor-url-value="<%= journal_entry_path(Date.current) %>"
       data-journal-editor-csrf-value="<%= form_authenticity_token %>"
       <% if current_user.hey_connected? %>data-journal-editor-status-url-value="<%= journal_entry_status_path(Date.current) %>"<% end %>>
    <div class="jrnl-header">
      <span class="jrnl-date"><%= Date.current.strftime("%B %-d") %> <span class="jrnl-dow"><%= Date.current.strftime("%a") %></span></span>
      <div class="jrnl-header-meta">
        <% if current_user.hey_connected? %>
          <%= icon "hey", class: "jrnl-hey-tile" %>
          <% if @rp_journal_hey_synced %>
            <span class="jrnl-hey-badge jrnl-hey-badge--synced" data-journal-editor-target="heyBadge" title="Your last save matches what’s in HEY Journal for today.">Journal · Synced</span>
          <% elsif @rp_journal.present? %>
            <span class="jrnl-hey-badge jrnl-hey-badge--idle" data-journal-editor-target="heyBadge" title="HEY is connected. This note is saved in Daybreak; we send each version to HEY Journal automatically.">Journal</span>
          <% else %>
            <span class="jrnl-hey-badge jrnl-hey-badge--idle" data-journal-editor-target="heyBadge" title="HEY is connected. Notes you write below are saved here and sent to HEY Journal after each save.">Journal</span>
          <% end %>
        <% end %>
        <span class="jrnl-status" data-journal-editor-target="status"></span>
      </div>
    </div>
    <div class="jrnl-body"
         contenteditable="true"
         role="textbox"
         aria-multiline="true"
         aria-label="Today’s journal"
         spellcheck="true"
         data-journal-editor-target="editor"
         data-action="input->journal-editor#onInput"
         data-placeholder="How’s today going? Write a few lines…"><%= sanitize(@rp_journal&.content.to_s) %></div>
    <div class="jrnl-toolbar">
      <button type="button" class="jrnl-btn" data-action="click->journal-editor#bold" title="Bold"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg></button>
      <button type="button" class="jrnl-btn" data-action="click->journal-editor#italic" title="Italic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="4" x2="10" y2="4"/><line x1="14" y1="20" x2="5" y2="20"/><line x1="15" y1="4" x2="9" y2="20"/></svg></button>
      <button type="button" class="jrnl-btn" data-action="click->journal-editor#strikethrough" title="Strikethrough"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><path d="M16 6C16 6 14.5 4 12 4C9 4 7 6 7 8C7 10 9 11 12 12"/><path d="M8 18C8 18 9.5 20 12 20C15 20 17 18 17 16C17 14 15 13 12 12"/></svg></button>
      <div class="jrnl-divider"></div>
      <button type="button" class="jrnl-btn" data-action="click->journal-editor#link" title="Link"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></button>
      <div class="jrnl-divider"></div>
      <button type="button" class="jrnl-btn" data-action="click->journal-editor#heading" title="Heading"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16"/><path d="M4 18V6"/><path d="M20 18V6"/></svg></button>
      <button type="button" class="jrnl-btn" data-action="click->journal-editor#blockquote" title="Quote"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg></button>
      <button type="button" class="jrnl-btn" data-action="click->journal-editor#code" title="Code"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></button>
      <div class="jrnl-divider"></div>
      <button type="button" class="jrnl-btn" data-action="click->journal-editor#bulletList" title="Bullet list"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="9" y1="6" x2="20" y2="6"/><line x1="9" y1="12" x2="20" y2="12"/><line x1="9" y1="18" x2="20" y2="18"/><circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="18" r="1.5" fill="currentColor" stroke="none"/></svg></button>
      <button type="button" class="jrnl-btn" data-action="click->journal-editor#orderedList" title="Numbered list"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><path d="M4 6h1v4"/><path d="M4 10h2"/><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1.5"/></svg></button>
    </div>
  </div>

  <%# Goals tab %>
  <div class="r-tab-content" id="rc-goals" data-right-panel-target="tab" data-tab="goals">
    <div class="r-head">
      <div class="r-dot r-dot--amber"></div>
      <div class="r-head-title">Weekly goals</div>
    </div>
    <div class="g-list">
      <% if @rp_goals&.any? %>
        <% goals_done = @rp_goals.count(&:completed?) %>
        <% week_total = @rp_goal_progress[:total].to_i %>
        <% week_done = @rp_goal_progress[:done].to_i %>
        <div class="g-week">
          <div class="g-week__row">
            <span class="g-week__label">This week</span>
            <span class="g-week__frac"><%= week_done %> of <%= pluralize(week_total, "to-do") %> done</span>
          </div>
          <div class="g-progress" role="progressbar" aria-label="To-dos done this week" aria-valuemin="0" aria-valuemax="<%= week_total %>" aria-valuenow="<%= week_done %>">
            <div class="g-progress-fill" style="width: <%= week_total.zero? ? 0 : (week_done * 100.0 / week_total).round %>%"></div>
          </div>
        </div>

        <div class="g-head">
          <span class="g-head__title">Goals</span>
          <span class="g-head__count"><%= goals_done %> of <%= @rp_goals.size %></span>
        </div>
        <ul class="g-goals">
          <% @rp_goals.each do |goal| %>
            <li class="g-goal <%= 'g-goal--done' if goal.completed? %>">
              <%= button_to weekly_goal_path(goal), method: :patch, params: { completed: goal.completed? ? 0 : 1 },
                    class: "g-goal__check", form_class: "g-goal__form",
                    aria: { label: goal.completed? ? "Mark “#{goal.title}” not done" : "Mark “#{goal.title}” done", pressed: goal.completed? } do %>
                <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <% if goal.completed? %>
                    <circle cx="8" cy="8" r="7" fill="#16A34A"/>
                    <path d="M5 8.2l2 2 4-4.4" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  <% else %>
                    <circle cx="8" cy="8" r="6.6" stroke="currentColor" stroke-width="1.25"/>
                  <% end %>
                </svg>
              <% end %>
              <span class="g-goal__title"><%= goal.title %></span>
            </li>
          <% end %>
        </ul>
        <%= link_to "Edit goals", weekly_checkin_path, class: "g-edit" %>
      <% else %>
        <div class="r-empty">
          <p class="r-empty__title">No goals this week yet</p>
          <p class="r-empty__sub">Pick two or three things that would make the week a good one.</p>
          <%= link_to "Set weekly goals", weekly_checkin_path, class: "btn btn--primary btn--small" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# Icon rail — panel toggle lives here so it stays visible (shell overflow would clip a seam-hugging control) %>
<nav class="r-rail">
  <button type="button" class="rri rri--panel-toggle" data-right-panel-target="toggleBtn" data-action="click->right-panel#toggle" aria-expanded="true" aria-label="Collapse side panel" title="Collapse side panel">
    <%= icon "panel-right", class: "rri--panel-toggle-icon" %>
  </button>
  <button type="button" class="rri on" aria-label="Basecamp" data-action="click->right-panel#switchTab" data-tab="bc" data-right-panel-target="railBtn">
    <%= source_tile "basecamp", class: "rri-tile" %>
    <span class="rri-tip">Basecamp</span>
  </button>
  <button type="button" class="rri" aria-label="HEY" data-action="click->right-panel#switchTab" data-tab="hey" data-right-panel-target="railBtn">
    <%= source_tile "hey", class: "rri-tile" %>
    <span class="rri-tip">HEY</span>
  </button>
  <div class="r-rail-div" aria-hidden="true"></div>
  <button type="button" class="rri" aria-label="Goals" data-action="click->right-panel#switchTab" data-tab="goals" data-right-panel-target="railBtn">
    <%= icon "bookmark", class: "nav-icon" %>
    <span class="rri-tip">Goals</span>
  </button>
  <button type="button" class="rri" aria-label="Daily log" data-action="click->right-panel#switchTab" data-tab="log" data-right-panel-target="railBtn">
    <%= render "icons/nav/daily_log" %>
    <span class="rri-tip">Daily log</span>
  </button>
  <button type="button" class="sheet-close" data-action="click->right-panel#toggle" aria-label="Close inbox">
    <%= icon "close" %>
  </button>
</nav>
