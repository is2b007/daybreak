<%# locals: (email:) %>
<% sender = email.sender_name.presence || email.sender_email.presence || "Unknown sender" %>
<div class="modal-overlay"
     data-controller="modal"
     data-action="click->modal#closeIfBackdrop">
  <div class="modal modal--task modal--email">

    <div class="modal__topbar">
      <div class="modal__channel">
        <%= icon "hey", class: "modal__channel-hey" %>
        <span>HEY<%= " · #{email.label}" if email.label.present? %></span>
      </div>
      <div class="modal__topbar-actions">
        <%= button_to "Add to Today",
              plan_hey_email_path(email),
              method: :post,
              params: { target_date: Date.current.iso8601, target_bucket: "day" },
              class: "btn btn--secondary btn--small modal__add-today-btn",
              form: { data: { turbo_stream: true } } %>
        <button type="button"
                class="modal__close"
                data-action="click->modal#close"
                aria-label="Close modal">×</button>
      </div>
    </div>

    <div class="email-modal">
      <h2 class="email-modal__subject"><%= email.subject %></h2>

      <div class="email-modal__from">
        <%= contact_avatar(email.sender_name, email.sender_email) %>
        <div class="email-modal__who">
          <span class="email-modal__sender"><%= sender %></span>
          <% if email.sender_name.present? && email.sender_email.present? %>
            <span class="email-modal__address"><%= email.sender_email %></span>
          <% end %>
        </div>
        <time class="email-modal__time" datetime="<%= email.received_at&.iso8601 %>"
              title="<%= email.received_at&.in_time_zone&.strftime("%A %-d %B %Y, %-l:%M%P") %>"><%= inbox_time(email.received_at) %></time>
      </div>

      <% if email.snippet.present? %>
        <p class="email-modal__snippet"><%= email.snippet %></p>
      <% end %>

      <% if email.safe_hey_url.present? %>
        <%= link_to email.safe_hey_url, target: "_blank", rel: "noopener noreferrer", class: "email-modal__open" do %>
          Read the full email in HEY
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
        <% end %>
      <% end %>
    </div>

  </div>
</div>
