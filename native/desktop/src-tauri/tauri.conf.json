{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daybreak",
  "version": "0.1.1",
  "identifier": "app.daybreak.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "A calm daily and weekly planner",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["daybreak"]
      }
    }
  }
}
